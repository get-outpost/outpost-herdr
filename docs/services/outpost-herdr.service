[Unit]
Description=Outpost Herdr agent relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/outpost-herdr run --namespace %H:default
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
